<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde Android 12+ (targetSdk 31+) : sauvegarde automatique dans le cloud Google et copie
    vers un nouvel appareil. Les jeux personnalisés, le championnat en cours, les derniers noms de
    joueurs et le thème sont dans des SharedPreferences (domaine "sharedpref"). Le journal des
    parties est un fichier par partie dans filesDir/journal (domaine "file", dossier "journal",
    voir GameHistoryRepository.DIR_NAME). Les deux sont sauvegardés, et rien d'autre.
    Les SharedPreferences contiennent aussi l'ancien journal, gardé comme filet de sécurité après
    la migration vers des fichiers, et la copie de sécurité des données illisibles
    (clé "saved_games_unreadable_backup").
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="journal" />
    </device-transfer>
</data-extraction-rules>
