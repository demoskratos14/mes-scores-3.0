<?xml version="1.0" encoding="utf-8"?>
<!-- Langues de l'appli : elles apparaissent aussi dans Réglages > Applications > Mes Scores > Langue (Android 13+).
     Garder cette liste identique aux dossiers res/values-xx et à l'énumération AppLanguage (vérifié par AppLanguageTest). -->
