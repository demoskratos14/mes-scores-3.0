<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème de la fenêtre (avant que Compose ait dessiné sa première image) : au démarrage et surtout
        quand Android recrée l'écran après un changement de langue. Le fond reprend la couleur moyenne
        de la photo assombrie, pour qu'aucun flash noir ou blanc ne s'intercale. Le parent reste un
        thème AppCompat, exigé par AppCompatActivity.
    -->
    <style name="Theme.MesScores" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Moyenne de la photo de fond sous le voile du thème clair (55 % de noir). -->
    <color name="window_background">#3C3226</color>
</resources>
